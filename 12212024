#include <Joystick.h>
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <math.h>

// --- Sensor Address ---
#define MPU6050_ADDRESS 0x68

// --- Sensor Object ---
Adafruit_MPU6050 mpu;

// --- Joystick Constants ---
#define JOY_MIN -1023
#define JOY_MAX 1023

// --- Calibration ---
float accelXZeroG = 0;
float accelYZeroG = 0;
float accelZZeroG = 0;

// --- Constants ---
#define ACCEL_READ_DELAY_MS 5
#define DEADZONE 0.08f
#define TILT_RANGE 30.0f
#define FILTER_ALPHA_BASE 0.15f
#define CALIBRATION_SAMPLES 1000

// --- Global Variables ---
float rawAccelX, rawAccelY, rawAccelZ;
float filteredAccelX = 0, filteredAccelY = 0, filteredAccelZ = 0;
bool firstRead = true;

// --- Joystick Object ---
Joystick_ Joystick(
  JOYSTICK_DEFAULT_REPORT_ID, JOYSTICK_TYPE_GAMEPAD,
  0, 0,  // buttons, hat switches
  true, true, false, false, false, false,  // X/Y only
  false, false, false, false, false
);

// --- Function Prototypes ---
void calibrateAccelerometer();
void readAccelerometer();
void handleTilt();
float customMap(float x, float in_min, float in_max, float out_min, float out_max);
float lowPassFilter(float newValue, float previousValue, float alpha);
float applyDeadzone(float value, float threshold);
inline float radiansToDegrees(float rad) { return rad * 57.2957795f; }

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);

  if (!mpu.begin(MPU6050_ADDRESS)) {
    Serial.println("MPU6050 Not Found!");
    while (1);
  }

  Serial.println("MPU6050 Found!");
  mpu.setAccelerometerRange(MPU6050_RANGE_4_G);
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);

  calibrateAccelerometer();

  Joystick.begin();
  Joystick.setXAxisRange(JOY_MIN, JOY_MAX);
  Joystick.setYAxisRange(JOY_MIN, JOY_MAX);
}

void loop() {
  readAccelerometer();
  handleTilt();
  delay(ACCEL_READ_DELAY_MS);
}

// --- Calibration ---
void calibrateAccelerometer() {
  Serial.println("Calibrating accelerometer... Keep still.");
  delay(3000);

  float sumX = 0, sumY = 0, sumZ = 0;
  for (int i = 0; i < CALIBRATION_SAMPLES; i++) {
    sensors_event_t accel, gyro, temp;
    mpu.getEvent(&accel, &gyro, &temp);
    sumX += accel.acceleration.x;
    sumY += accel.acceleration.y;
    sumZ += accel.acceleration.z;
    delay(2);
  }

  accelXZeroG = sumX / CALIBRATION_SAMPLES;
  accelYZeroG = sumY / CALIBRATION_SAMPLES;
  accelZZeroG = sumZ / CALIBRATION_SAMPLES;

  Serial.printf("Calibration done: X=%.3f, Y=%.3f, Z=%.3f\n", accelXZeroG, accelYZeroG, accelZZeroG);
}

// --- Read Sensor ---
void readAccelerometer() {
  sensors_event_t accel, gyro, temp;
  mpu.getEvent(&accel, &gyro, &temp);

  rawAccelX = accel.acceleration.x - accelXZeroG;
  rawAccelY = accel.acceleration.y - accelYZeroG;
  rawAccelZ = accel.acceleration.z - accelZZeroG;

  // Initialize filter with first reading
  if (firstRead) {
    filteredAccelX = rawAccelX;
    filteredAccelY = rawAccelY;
    filteredAccelZ = rawAccelZ;
    firstRead = false;
    return;
  }

  // Adaptive smoothing: increase alpha if motion is large
  float magnitude = fabs(rawAccelX) + fabs(rawAccelY);
  float alpha = FILTER_ALPHA_BASE + (magnitude > 1.0f ? 0.05f : 0.0f);
  alpha = constrain(alpha, 0.05f, 0.25f);

  filteredAccelX = lowPassFilter(rawAccelX, filteredAccelX, alpha);
  filteredAccelY = lowPassFilter(rawAccelY, filteredAccelY, alpha);
  filteredAccelZ = lowPassFilter(rawAccelZ, filteredAccelZ, alpha);
}

// --- Handle Tilt ---
void handleTilt() {
  // Sanity check (avoid NaN)
  if (isnan(filteredAccelX) || isnan(filteredAccelY) || isnan(filteredAccelZ))
    return;

  float tiltX = radiansToDegrees(atan2f(filteredAccelY, filteredAccelZ));
  float tiltY = radiansToDegrees(atan2f(filteredAccelX, filteredAccelZ));

  float joyX = map(tiltX, -TILT_RANGE, TILT_RANGE, JOY_MAX, JOY_MIN);
  float joyY = map(tiltY, -TILT_RANGE, TILT_RANGE, JOY_MIN, JOY_MAX);

  joyX = applyDeadzone(joyX, DEADZONE * JOY_MAX);
  joyY = applyDeadzone(joyY, DEADZONE * JOY_MAX);

  joyX = customMap(joyX, JOY_MIN, JOY_MAX, JOY_MIN, JOY_MAX);
  joyY = customMap(joyY, JOY_MIN, JOY_MAX, JOY_MIN, JOY_MAX);

  joyY = -joyY; // Invert Y

  joyX = constrain(joyX, JOY_MIN, JOY_MAX);
  joyY = constrain(joyY, JOY_MIN, JOY_MAX);

  Joystick.setXAxis((int)joyX);
  Joystick.setYAxis((int)joyY);

  // Optional debug (every 50 cycles)
  static int counter = 0;
  if (++counter >= 50) {
    counter = 0;
    Serial.printf("Tilt X: %.2f° Y: %.2f° | Joy X: %d Y: %d\n", tiltX, tiltY, (int)joyX, (int)joyY);
  }
}

// --- Helpers ---
float lowPassFilter(float newValue, float previousValue, float alpha) {
  return previousValue + alpha * (newValue - previousValue);
}

float applyDeadzone(float value, float threshold) {
  if (fabs(value) < threshold) return 0;
  float sign = (value > 0) ? 1.0f : -1.0f;
  return sign * ((fabs(value) - threshold) / (JOY_MAX - threshold)) * JOY_MAX;
}

float customMap(float x, float in_min, float in_max, float out_min, float out_max) {
  x = constrain(x, in_min, in_max);
  float normalized = (x - in_min) / (in_max - in_min);
  normalized = (normalized * 2.0f) - 1.0f;
  float mapped = (normalized >= 0) ? powf(normalized, 2.5f) : -powf(-normalized, 2.5f);
  mapped = (mapped + 1.0f) / 2.0f;
  return out_min + mapped * (out_max - out_min);
}
